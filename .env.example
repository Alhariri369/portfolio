# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Admin (HTTP Basic Auth on /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Database ---
# Production: Neon Postgres connection string (never on the device).
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
# Local dev (no Postgres): SQLite file.
DATABASE_URL=sqlite:///./app.db

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=portfolio@hariri-dev.com
EMAIL_TO=moh.alhariri369@gmail.com

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Uploads ---
# In Docker the compose file mounts ./data:/data, so this stays /data/uploads.
UPLOAD_DIR=/data/uploads

# --- Backups (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Analytics (optional; empty means no beacon is rendered) ---
CF_ANALYTICS_TOKEN=
